# ---------------------------------------------------------------------------
# Client-safe values (VITE_* are baked into the frontend build at build time).
# These are NOT secrets — they're protected by Postgres RLS, not by secrecy.
# In this project they live in the COMMITTED apps/web/.env.production file.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGc...

# ---------------------------------------------------------------------------
# Server-only secrets. NEVER commit these. Set them in the Vercel dashboard
# (Project Settings -> Environment Variables). No MCP tool in this session
# can set them for you — this is a manual step.
# ---------------------------------------------------------------------------

# Service-role key: bypasses RLS. Used by api/crawl.ts (writing
# properties/enrichments as a system job, no end-user JWT context there) and
# by every /api/admin/* route (role changes, invitations, advisor
# connections) — required for the admin dashboard to work at all.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked by api/notify.ts against the Authorization header,
# so only the GitHub Actions cron job (or you, manually) can trigger the
# daily notification run.
CRON_SECRET=

# Every *_MOCK_MODE flag below defaults to OFF (live). A source only serves
# fabricated data when its flag is explicitly "true" — set them for offline
# local development, never in a deployment, or /api/property-lookup starts
# reporting mock matrikelnumre and valuations as if they were register facts.
# The response's `sources` array names the mode of each register per request.

# BBR enrichment (server/lib/enrichment-sources/bbr.ts) via Datafordeler's
# entity-based GraphQL service, reached by walking DAR's Husnummer entity
# across to BBR (husnummerGiverAdgangTilBygning). DATAFORDELER_API_KEY is the
# API key issued through Datafordeler's self-service portal — this is NOT the
# older REST "tjenestebruger" username/password, which only works for fetching
# the GraphQL schema, not for querying entity data. Without a key BBR reports
# an unavailable source rather than inventing building facts.
# BBR_MOCK_MODE=true
DATAFORDELER_API_KEY=
# Overrides the per-register version segment and full endpoint for the
# DAR->BBR traversal (https://graphql.datafordeler.dk/DAR/<version>). Leave
# both unset unless there is a reason not to: registers are versioned
# independently and withdrawn versions answer HTTP 404 (which is what took BBR
# down when DAR moved off v1), so the client tries the known versions
# newest-first and remembers the one that answers. Setting either of these
# pins one endpoint and disables that fallback.
# DATAFORDELER_DAR_VERSION=v3
# DATAFORDELER_DAR_API_BASE=

# Address/cadastral enrichment (server/lib/enrichment-sources/address-lookup.ts)
# via Datafordeler's DAR GraphQL service (address-lookup-dar.ts), using the
# DATAFORDELER_API_KEY above. It resolves the DAR husnummer UUID and the
# register's access-point coordinates (the geocoder for the noise lookup), plus
# matrikelnr, ejerlav and BFE-nummer through the Flexible service. The parcel
# step is failure-isolated and leaves those fields empty when the husnummer
# sits on several parcels or estates. Without a key, or when DAR has no unique
# match, Adressevælger below answers identity and coordinates but no parcel.
# DAWA, which this used to call, closed 2026-10-01 (HTTP 410). Zone status is
# NOT available: it was retired with DAWA.
# ADDRESS_LOOKUP_MOCK_MODE=true
# Optional pins for the Flexible service (https://graphql.datafordeler.dk/Flexible/<version>).
# DATAFORDELER_FLEXIBLE_VERSION=v2
# DATAFORDELER_FLEXIBLE_API_BASE=

# Address lookup by id (server/lib/enrichment-sources/adressevaelger.ts).
# Adressevælger, https://adressevaelger.dk, is the open, keyless address
# service that replaced DAWA: no registration, only a `token` of 10+ arbitrary
# characters. Both default to the values KDS publishes, so leave unset unless
# KDS introduces user management. The browser autocomplete uses the default.
# ADRESSEVAELGER_API_BASE=
# ADRESSEVAELGER_TOKEN=

# Matriklen (MAT) enrichment (server/lib/enrichment-sources/matrikel.ts):
# Datafordeler's MAT GraphQL service (https://graphql.datafordeler.dk/MAT/v3),
# same DATAFORDELER_API_KEY as BBR above, no separate credential. It reads the
# land's registered area and what is registered on it (fredskov,
# strandbeskyttelse, klitfredning, farmland note) for the due-diligence
# checklist, and the registered area the crawl stores. Live by default: leave
# this unset. "true" serves a deterministic fake and switches the real lookup off.
# MATRIKEL_MOCK_MODE=true
# Overrides the per-register version segment in the endpoint URL
# (https://graphql.datafordeler.dk/MAT/<version>). Setting it pins one version.
# DATAFORDELER_MAT_VERSION=v3
# DATAFORDELER_MAT_API_BASE=

# Ejendomsvurdering (official public property valuation) enrichment
# (server/lib/enrichment-sources/ejendomsvurdering.ts and vur-valuations.ts):
# Datafordeler's VUR GraphQL service (https://graphql.datafordeler.dk/VUR/v2),
# same DATAFORDELER_API_KEY as BBR above. Keyed by BFE number: a BFE the
# caller holds is used as it is, and a house's BFE is otherwise found from its
# husnummer through BBR. The field names are fixed from the published schema;
# Datafordeler has switched schema introspection off. When no valuation is
# found the source is reported unavailable, deliberately, since a
# plausible-looking fabricated assessed value is worse than none.
# EJENDOMSVURDERING_MOCK_MODE=true
# Overrides the per-register version segment in the endpoint URL
# (https://graphql.datafordeler.dk/VUR/<version>). Same fallback caveat as
# DATAFORDELER_DAR_VERSION above: setting this pins one version.
# DATAFORDELER_VUR_VERSION=v2
# DATAFORDELER_VUR_API_BASE=

# Noise enrichment (server/lib/enrichment-sources/stoejkort.ts): Miljøstyrelsens
# støjkort (road/rail traffic noise, Lden) via a WFS on geoserver.plandata.dk.
# The "Støjkort" theme group requires contacting Miljøstyrelsen for access —
# not a fully open self-serve endpoint — so the layer name is configuration,
# not a default. With STOEJKORT_TYPENAME unset the lookup is skipped and
# reported as unconfigured; a guessed layer name only earns an HTTP 400 that
# reads like an outage. Take the name from a live GetCapabilities response.
# Setting the mock flag brings back a synthetic dB value that reads like a
# measurement, so keep it to local development.
# STOEJKORT_MOCK_MODE=true
# STOEJKORT_TYPENAME=
# The feature attribute holding the Lden value. Defaults to any numeric
# property whose name starts with "lden"; set it when the layer disagrees.
# STOEJKORT_LDEN_PROPERTY=

# STOEJKORT_API_BASE=

# ---------------------------------------------------------------------------
# Register lookups (all optional).
# ---------------------------------------------------------------------------
CRAWL_TIMEOUT_MS=10000      # per-request timeout for register lookups

# Postal code (postnummer) ranges used to scope the municipal links shown for
# spildevandsplaner, as comma-separated "min-max" intervals, e.g.
# "9000-9900,6000-6600". Default 9000-9900 (Region Nordjylland).
CRAWL_ZIP_RANGES=9000-9900

# ---------------------------------------------------------------------------
# Search API tuning.
# ---------------------------------------------------------------------------
# Hard ceiling on `limit` for GET /api/properties, regardless of what the
# caller requests. Raise/lower later without a code change.
SEARCH_MAX_PAGE_SIZE=100

# CORS: the frontend origin allowed to call /api/*. Defaults to "*" when
# unset — set it to the deployed frontend URL in production. Also used to
# build links in invitation and notification emails (e.g. FRONTEND_URL/property/:id).
FRONTEND_URL=

# ---------------------------------------------------------------------------
# Notification email (api/notify.ts, server/lib/notify/*). Sends an email via
# Resend (https://resend.com) when a saved search's alert cadence is due and
# new listings match its filters.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified sender/domain in the Resend dashboard.
NOTIFY_FROM_EMAIL=alerts@yourdomain.dk

# ---------------------------------------------------------------------------
# GitHub Actions secrets (set in repo Settings -> Secrets and variables ->
# Actions). Needed by .github/workflows/crawl.yml and deploy.yml.
# ---------------------------------------------------------------------------
VERCEL_URL=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ---------------------------------------------------------------------------
# Admin "Fetch new listings" button (api/admin.ts?resource=new-listings).
# Fine-grained GitHub token limited to this repo with "Actions: Read and
# write". Set in the Vercel dashboard; without it the endpoint answers 503.
# ---------------------------------------------------------------------------
GITHUB_DISPATCH_TOKEN=
# Optional overrides; default to scottlinddk/boligdata on main.
# ADMIN_WORKFLOW_REPOSITORY=owner/repo
# ADMIN_WORKFLOW_REF=main
